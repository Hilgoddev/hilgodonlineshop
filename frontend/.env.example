# Frontend Environment Variables
# Copy this file to .env.local and fill in the values.
# Anything named NEXT_PUBLIC_* is sent to the browser — only public values here
# (never the Supabase service role key or any secret key).

# Supabase URL + anon key: public by design; the database's RLS policies decide
# what they can do (read public data, sign in).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base, INCLUDING /api — the browser calls /api/* and Next rewrites
# it to this URL.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Optional, server-side only: absolute backend URL used while rendering pages
# on the server (falls back to NEXT_PUBLIC_API_URL).
BACKEND_URL=

NODE_ENV=development

# Stripe — set NEXT_PUBLIC_STRIPE_ENABLED=true to unlock Stripe at checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_STRIPE_ENABLED=false

# Bank Transfer — set to true to unlock direct bank transfer at checkout
NEXT_PUBLIC_BANK_TRANSFER_ENABLED=false

# Blog — set to true to show blog posts (false shows a Coming Soon page)
NEXT_PUBLIC_BLOG_ENABLED=false
