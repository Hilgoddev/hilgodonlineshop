# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL (local dev or Render URL)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

NODE_ENV=development

# Stripe — set NEXT_PUBLIC_STRIPE_ENABLED=true to unlock Stripe at checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_STRIPE_ENABLED=false

# Bank Transfer — set to true to unlock direct bank transfer at checkout
NEXT_PUBLIC_BANK_TRANSFER_ENABLED=false

# Blog — set to true to show blog posts (false shows a Coming Soon page)
NEXT_PUBLIC_BLOG_ENABLED=false

