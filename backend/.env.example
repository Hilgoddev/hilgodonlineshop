# Backend Environment Variables
# Copy this file to .env and fill in real values — never commit .env to git

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# ── Stripe (optional — leave blank to keep Stripe hidden at checkout) ───────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Grey (foreign-card payments) ────────────────────────────────────────────
GREY_API_KEY=your_grey_api_key
GREY_WEBHOOK_SECRET=your_grey_webhook_secret

# ── Bank Transfer details (served by GET /api/payment/bank-details) ─────────
# Set NEXT_PUBLIC_BANK_TRANSFER_ENABLED=true in the frontend to unlock this flow
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NAME=Your Account Name
BANK_ACCOUNT_NUMBER=0000000000
BANK_SORT_CODE=000000

# ── Email / Notifications ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
PAYOUT_NOTIFY_EMAIL=finance@example.com

# ── App ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://www.hilgod.com
PORT=5000
NODE_ENV=development
