# Backend Environment Variables
# Copy this file to .env and fill in real values — never commit .env to git

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — server only, bypasses RLS. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Public anon key — used only to check a user's current password on change.
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# ── Stripe (optional — leave blank to keep Stripe hidden at checkout) ───────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Grey (foreign-card payments) ────────────────────────────────────────────
GREY_API_KEY=your_grey_api_key
GREY_WEBHOOK_SECRET=your_grey_webhook_secret

# ── Bank Transfer details (served by GET /api/payment/bank-details) ─────────
# Set NEXT_PUBLIC_BANK_TRANSFER_ENABLED=true in the frontend to unlock this flow
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NAME=Your Account Name
BANK_ACCOUNT_NUMBER=0000000000
BANK_SORT_CODE=000000

# ── Email / Notifications (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=admin@example.com
PAYOUT_NOTIFY_EMAIL=finance@example.com
# Optional — defaults shown
EMAIL_FROM_ORDERS=Hilgod Orders <order@hilgod.com>
EMAIL_FROM_NOREPLY=Hilgod <noreply@hilgod.com>
EMAIL_LOGO_URL=https://www.hilgod.com/email-logo.png
COMPANY_NAME=Hilgod Online Store
COMPANY_WEBSITE=hilgod.com
SUPPORT_EMAIL=support@hilgod.com
# Shown in customer emails — the built-in fallback is a placeholder ("+123")
SUPPORT_PHONE=+234 000 000 0000

# ── Exchange rates (optional — a built-in fallback is used without them) ────
CURRENCYFREAKS_API_KEY=
EXCHANGERATE_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://www.hilgod.com
PORT=5000
NODE_ENV=development
# "false" auto-confirms new sign-ups without an email link (dev only)
EMAIL_VERIFICATION_ENABLED=true
